		sourceColumn: barrierlens_n
		summarizeBy: none

	column source_note
		dataType: string
		sourceColumn: source_note
		summarizeBy: none

	column comparability
		dataType: string
		sourceColumn: comparability
		summarizeBy: none

	partition base_paper_reference = m
		mode: import
		source =
			let
				Source = Csv.Document(
					File.Contents(DashboardDataPath & "/base_paper_reference.csv"),
					[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
			in
				#"Promoted Headers"

