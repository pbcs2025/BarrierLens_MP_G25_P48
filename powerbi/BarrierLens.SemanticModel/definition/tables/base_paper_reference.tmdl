		sourceColumn: description
		summarizeBy: none

	column base_paper_rate
		dataType: double
		sourceColumn: base_paper_rate
		summarizeBy: none

	column barrierlens_observed
		dataType: double
		sourceColumn: barrierlens_observed
		summarizeBy: none

	column barrierlens_predicted
