table _Metrics
	lineageTag: 995e48dc-4f0d-4325-8878-d678c211e9b9

	measure 'Total Women Analysed' = MAX(national_kpi_summary[total_women])
		displayFolder: 01 National Overview
		formatString: #,0

	measure 'Observed Any Barrier Rate' = MAX(national_kpi_summary[observed_any_barrier_rate])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Predicted Household Barrier Probability' = MAX(national_kpi_summary[pred_household_prob])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Predicted Logistical Barrier Probability' = MAX(national_kpi_summary[pred_logistic_prob])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Predicted Health Facility Barrier Probability' = MAX(national_kpi_summary[pred_facility_prob])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Composite Barrier Score' = MAX(national_kpi_summary[pred_composite_barrier_score])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'National Observed Household Rate' = MAX(national_kpi_summary[observed_household_rate])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'National Observed Logistic Rate' = MAX(national_kpi_summary[observed_logistic_rate])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'National Observed Facility Rate' = MAX(national_kpi_summary[observed_facility_rate])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Mean Stage 2 ANC Prediction' = VAR n = MAX(national_kpi_summary[stage2_anc_gap_N]) RETURN IF(n > 0, MAX(national_kpi_summary[stage2_anc_gap_pred_prob]), BLANK())
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'Mean Unmet FP Prediction' = MAX(national_kpi_summary[stage2_unmet_fp_pred_prob])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'State Mean Predicted Composite Barrier' = AVERAGE(state_level_summary[pred_composite_barrier_score])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Observed Household' = AVERAGE(state_level_summary[observed_household_rate])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Predicted Household' = AVERAGE(state_level_summary[pred_household_prob])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Observed Logistic' = AVERAGE(state_level_summary[observed_logistic_rate])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Predicted Logistic' = AVERAGE(state_level_summary[pred_logistic_prob])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Observed Facility' = AVERAGE(state_level_summary[observed_facility_rate])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Mean Predicted Facility' = AVERAGE(state_level_summary[pred_facility_prob])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'Selected State Women Count' = SUM(state_level_summary[N])
		displayFolder: 03 State Analysis
		formatString: #,0

	measure 'State Ranking Barrier Score' = AVERAGE(state_ranking_long[pred_composite_barrier_score])
		displayFolder: 02 State Analysis
		formatString: 0.0%

	measure 'Barrier Long Value' = AVERAGE(national_barrier_long[value])
		displayFolder: 01 National Overview
		formatString: 0.0%

	measure 'State Barrier Long Observed' = AVERAGE(state_barrier_long[mean_observed_rate])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'State Barrier Long Predicted' = AVERAGE(state_barrier_long[mean_predicted_prob])
		displayFolder: 03 State Analysis
		formatString: 0.0%

	measure 'Demographic Mean Observed Rate' = AVERAGE(demographic_summary[mean_observed_rate])
		displayFolder: 04 Demographics
		formatString: 0.0%

	measure 'Demographic Mean Predicted Prob' = AVERAGE(demographic_summary[mean_predicted_prob])
		displayFolder: 04 Demographics
		formatString: 0.0%

	measure 'Dimension Comparison Value' = AVERAGE(demographic_dimension_long[value])
		displayFolder: 04 Demographics
		formatString: 0.0%

	measure 'Cluster Women Count' = SUM(cluster_summary[n_women])
		displayFolder: 05 Risk Archetypes
		formatString: #,0

	measure 'Cluster Share of Total' = AVERAGE(cluster_summary[share_of_total])
		displayFolder: 05 Risk Archetypes
		formatString: 0.0%

	measure 'Cluster Radar Metric Value' = AVERAGE(cluster_radar_long[value])
		displayFolder: 05 Risk Archetypes
		formatString: 0.000

	measure 'Cluster State Women' = SUM(cluster_state_distribution[n_women])
		displayFolder: 05 Risk Archetypes
		formatString: #,0

	measure 'Women with Confirmed Unmet Family Planning Need' = MAX(national_kpi_summary[stage2_unmet_fp_N])
		displayFolder: 06 Stage 2 Outcomes
		formatString: #,0

	measure 'Stage 2 Unmet FP Observed Rate' = MAX(national_kpi_summary[stage2_unmet_fp_observed_rate])
		displayFolder: 06 Stage 2 Outcomes
		formatString: 0.0%

	measure 'Stage 2 Unmet FP Predicted Prob' = MAX(national_kpi_summary[stage2_unmet_fp_pred_prob])
		displayFolder: 06 Stage 2 Outcomes
		formatString: 0.0%

	measure 'Stage 2 Outcome Value' = AVERAGE(stage2_outcome_long[value])
		displayFolder: 06 Stage 2 Outcomes
		formatString: 0.0%

	measure 'Stage 2 Best Area Under the ROC Curve' = MAX(model_comparison_table[ROC-AUC])
		displayFolder: 06 Stage 2 Outcomes
		formatString: 0.0000

	measure 'Avg Barrier Uplift' = AVERAGE(model_comparison_table[Barrier_Uplift])
		displayFolder: 06 Stage 2 Outcomes
		formatString: +0.0000;-0.0000

	measure 'Top SHAP Importance' = AVERAGE(shap_top20[mean_abs_shap])
		displayFolder: 07 Explainability
		formatString: 0.0000

	measure 'SHAP Feature Importance' = AVERAGE(shap_importance[mean_abs_shap])
		displayFolder: 07 Explainability
		formatString: 0.0000

	measure 'Stage 1 Best ROC-AUC' = MAX(stage1_model_comparison[ROC-AUC])
		displayFolder: 07 Explainability
		formatString: 0.0000

	measure 'Woman Count' = COUNTROWS(woman_level_master)
		displayFolder: 00 Slicers
		formatString: #,0

	measure 'Woman Mean Composite Barrier' = AVERAGE(woman_level_master[composite_barrier_score])
		displayFolder: 00 Slicers
		formatString: 0.0%

	measure 'Woman Observed Any Barrier Rate' = AVERAGEX(woman_level_master,IF(woman_level_master[observed_household] = 1 || woman_level_master[observed_logistic] = 1 || woman_level_master[observed_facility] = 1,1,0))
		displayFolder: 00 Slicers
		formatString: 0.0%

	measure 'Base Paper Comparison Value' = AVERAGE(base_paper_barrier_long[value])
		displayFolder: 02 Base Paper
		formatString: 0.0%

	column Placeholder
		isHidden
		lineageTag: 0cc02b8f-792a-4c80-8154-3bf5cc66137d
		dataType: string
		sourceColumn: Placeholder

	partition _Metrics = calculated
		mode: import
		source = ROW("Placeholder", BLANK())
